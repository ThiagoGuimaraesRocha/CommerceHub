{
  "info": {
    "name": "CommerceHub",
    "_postman_id": "0b7f6a52-3f5e-4d8e-9a57-6c1c3c2f1a01",
    "description": "Requests for the CommerceHub microservices. Import together with `CommerceHub.local.postman_environment.json`.\n\nRun the whole collection (Collection Runner or `newman`) in order: requests share product and order variables through collection variables.\n\nErrors follow RFC 9457 (`application/problem+json`). Monetary values use scale 4.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
