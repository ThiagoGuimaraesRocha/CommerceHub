      "key": "productSku",
      "value": ""
    },
    {
      "key": "productVersion",
      "value": "0"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderProductId",
      "value": ""
    },
    {
      "key": "orderProductSku",
      "value": ""
    },
    {
      "key": "customerId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "cancelOrderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "User Service readiness",
          "request": {
            "method": "GET",
            "url": "{{userServiceUrl}}/q/health/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200 and UP', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        },
        {
