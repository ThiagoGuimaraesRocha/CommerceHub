# Copy to .env (never commit .env) and replace every value.
# These values are only read on the FIRST Oracle start; to change them later
# run: docker compose down -v

ORACLE_PASSWORD=change-me-sys
ORACLE_HOST_PORT=1521

# Kafka external listener port exposed to the host (Sprint 4). In-cluster services
# always reach the broker at kafka:9092; host-side quarkus:dev uses localhost:29092.
KAFKA_HOST_PORT=29092

USER_DB_PASSWORD=change-me-user
PRODUCT_DB_PASSWORD=change-me-product
ORDER_DB_PASSWORD=change-me-order
INVENTORY_DB_PASSWORD=change-me-inventory
