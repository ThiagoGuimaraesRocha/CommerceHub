# Copy to .env (never commit .env) and replace every value.
# These values are only read on the FIRST Oracle start; to change them later
# run: docker compose down -v

ORACLE_PASSWORD=change-me-sys
ORACLE_HOST_PORT=1521

# Kafka external listener port exposed to the host (Sprint 4). In-cluster services
# always reach the broker at kafka:9092; host-side quarkus:dev uses localhost:29092.
KAFKA_HOST_PORT=29092
# Extra listener for OpenShift pods on the host IP (Sprint 7). scripts/up.sh sets
# KAFKA_OPENSHIFT_ADVERTISED_HOST to INFRA_HOST.
KAFKA_OPENSHIFT_HOST_PORT=39092

# IPv4 of this machine as seen from MicroShift pods (Oracle 1521, Kafka 39092, Jaeger 4317).
# Leave unset to autodetect in scripts/up.sh.
# INFRA_HOST=192.168.1.10

USER_DB_PASSWORD=change-me-user
PRODUCT_DB_PASSWORD=change-me-product
ORDER_DB_PASSWORD=change-me-order
INVENTORY_DB_PASSWORD=change-me-inventory

# Demonstration JWT (Sprint 5). Issuer must match across all services.
# The User Service creates the bootstrap ADMIN on first start when both
# DEMO_ADMIN_EMAIL and DEMO_ADMIN_PASSWORD are set. Change the placeholders.
JWT_ISSUER=https://commercehub.example/issuer
JWT_LIFESPAN_SECONDS=3600
DEMO_ADMIN_EMAIL=admin@commercehub.local
DEMO_ADMIN_PASSWORD=change-me-admin
DEMO_ADMIN_FULL_NAME=CommerceHub Admin

# Observability (Sprint 6). Grafana login is local-only; do not reuse this password elsewhere.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
